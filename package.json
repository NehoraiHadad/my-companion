{
  "name": "pocket-companion-prototype",
  "private": true,
  "version": "5.5.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:game": "node --test tests/game-engine.test.mjs tests/ai-game.test.mjs tests/animation-director.test.mjs tests/character-director.test.mjs tests/media-providers.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:android": "node --test tests/android-build.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build --emptyOutDir && node scripts/prepare-sites-build.mjs",
    "build:android": "npm run test:android && node scripts/patch-nitron-theme.mjs && tsc && vite build --emptyOutDir && node scripts/prepare-android-build.mjs && nitron build --target android"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "nitron": "^2.0.2",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
